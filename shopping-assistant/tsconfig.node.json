{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true
  },
  // playwright.config.ts and e2e/ are intentionally excluded: they need DOM +
  // Node types that this project does not carry, and Playwright compiles them
  // itself at run time. Adding them here would mean pulling in @types/node,
  // which is outside this task's dependency scope.
  "include": ["vite.config.ts", "vitest.config.ts"]
}
