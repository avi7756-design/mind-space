{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true
  },
  // playwright.config.ts and e2e/ live in tsconfig.e2e.json instead: they need
  // DOM + Node libs that the build tooling here does not. Run `npm run
  // typecheck:e2e` for those.
  "include": ["vite.config.ts", "vitest.config.ts"]
}
