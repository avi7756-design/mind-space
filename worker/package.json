{
  "name": "shopping-product-recognition",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudflare Worker that turns a product photo into a structured recognition result",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "smoke:provider": "tsx scripts/smoke-provider.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9",
    "wrangler": "^4.118.0",
    "@types/node": "^22.20.1"
  }
}
